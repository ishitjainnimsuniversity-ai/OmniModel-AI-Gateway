{
  "version": 2,
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/public/$1"
    },
    {
      "source": "/(style.css|app.js|logo.png|ai_bg.jpg|genesis_logo.png|alfa_logo.png)",
      "destination": "/public/$1"
    },
    {
      "source": "/v1/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    }
  ]
}
