{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/$1"
    },
    {
      "source": "/favicon.ico",
      "destination": "/assistant_logo.png"
    },
    {
      "source": "/(screen|screen_preview|preview|display|hardware|iot|simulator|lcd)",
      "destination": "/screen_preview.html"
    },
    {
      "source": "/(screen|screen_preview|preview|display|hardware|iot|simulator|lcd)/",
      "destination": "/screen_preview.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
